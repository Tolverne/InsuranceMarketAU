{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Synthetic population release manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "release_id",
    "status",
    "reference_date",
    "universe",
    "dataset_schema_version",
    "source_ids",
    "synthesis",
    "outputs",
    "quality_report_uri"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "release_id": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "draft",
        "published",
        "quarantined"
      ]
    },
    "reference_date": {
      "type": "string",
      "format": "date"
    },
    "universe": {
      "enum": [
        "registered_unrestricted",
        "registered_all",
        "insurable_extension",
        "combined_with_explicit_scope"
      ]
    },
    "dataset_schema_version": {
      "type": "string",
      "minLength": 1
    },
    "source_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true,
      "minItems": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "source_definition": {
      "type": "string",
      "minLength": 1
    },
    "geography_version": {
      "type": "string",
      "minLength": 1
    },
    "synthesis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method",
        "model_version",
        "population_draw_id",
        "random_algorithm",
        "random_seed"
      ],
      "properties": {
        "method": {
          "type": "string",
          "minLength": 1
        },
        "model_version": {
          "type": "string",
          "minLength": 1
        },
        "population_draw_id": {
          "type": "string",
          "minLength": 1
        },
        "random_algorithm": {
          "type": "string",
          "minLength": 1
        },
        "random_seed": {
          "type": "integer",
          "minimum": 0
        },
        "parameters_uri": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "outputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "table",
          "uri",
          "representation"
        ],
        "properties": {
          "table": {
            "type": "string",
            "minLength": 1
          },
          "uri": {
            "type": "string",
            "minLength": 1
          },
          "representation": {
            "enum": [
              "full",
              "weighted_sample",
              "aggregate"
            ]
          },
          "row_count": {
            "type": "integer",
            "minimum": 0
          },
          "weighted_vehicle_count": {
            "type": "number",
            "minimum": 0
          },
          "content_sha256": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "quality_report_uri": {
      "type": "string",
      "minLength": 1
    },
    "release_content_sha256": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{64}$"
    },
    "known_limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "published"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "release_content_sha256",
          "created_at"
        ],
        "properties": {
          "release_content_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    }
  ]
}
